.stats {
  display: flex;
  gap: 22rpx;
  margin-bottom: 50rpx;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}
.number { font-size: 52rpx; font-weight: 600; }
.label { color: #999; font-size: 23rpx; margin-top: 8rpx; }

.section-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.record-head { display: flex; justify-content: space-between; font-size: 30rpx; }
.date { color: #aaa; font-size: 22rpx; }
.intensity { color: #888; font-size: 23rpx; margin: 14rpx 0; }
.content { font-size: 27rpx; line-height: 1.6; margin-bottom: 18rpx; }
.summary {
  background: #F7F4EE;
  padding: 20rpx;
  border-radius: 18rpx;
  color: #666;
  font-size: 25rpx;
  line-height: 1.6;
}
.empty { text-align: center; color: #aaa; line-height: 2; margin-top: 120rpx; }