<view class="container">
  <view class="stats">
    <view class="stat-card">
      <view class="number">{{streak}}</view>
      <view class="label">连续记录天数</view>
    </view>
    <view class="stat-card">
      <view class="number">{{total}}</view>
      <view class="label">累计记录</view>
    </view>
  </view>

  <view class="section-title">我的情绪记录</view>

  <view class="card record" wx:for="{{records}}" wx:key="id">
    <view class="record-head">
      <text>{{item.emotion}}</text>
      <text class="date">{{item.created_at}}</text>
    </view>
    <view class="intensity">情绪强度 {{item.intensity}} / 100</view>
    <view class="content">{{item.content}}</view>
    <view class="summary">{{item.summary}}</view>
  </view>

  <view class="empty" wx:if="{{records.length === 0}}">
    还没有记录。<br/>从今天开始吧。
  </view>
</view>
