.header { margin-bottom: 48rpx; }
.title { font-size: 54rpx; font-weight: 600; margin-bottom: 14rpx; }
.subtitle { color: #888; font-size: 28rpx; }

.section-title { font-size: 32rpx; font-weight: 600; margin-bottom: 30rpx; }

.emotion-row { display: flex; justify-content: space-between; }
.emotion-item {
  text-align: center;
  padding: 18rpx 10rpx;
  border-radius: 20rpx;
  color: #888;
  font-size: 23rpx;
}
.emotion-item.selected {
  background: #F1EEE7;
  color: #333;
}
.emoji { font-size: 56rpx; margin-bottom: 8rpx; }

.textarea {
  width: 100%;
  min-height: 300rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.7;
}
.hint { color: #aaa; font-size: 22rpx; margin-top: 20rpx; }

.history-link {
  text-align: center;
  color: #777;
  margin-top: 42rpx;
  font-size: 26rpx;
}